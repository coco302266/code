# Docker 部署环境变量样例 —— 复制为 deploy/.env 后填写
# cp .env.docker.example .env

# ---- LLM ----
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=sk-替换成真实key

# ---- 裁判 / 标注模型（评测专用，不参与线上回答）----
# 只在跑离线评测工具时用到（L3 评判 / 四维评分 / 评测集标注）。
# 三个变量要么全配、要么全不配；留空则回落到上面的 LLM_*。
# 详见 backend/eval/judge_llm.py 与 backend/env.example 的说明。
EVAL_JUDGE_MODEL=qwen3.8-27b
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EVAL_JUDGE_NO_THINK=1

# ---- 数据库：两种接法，二选一（后端实际用下面的 LOCAL_MYSQL_*）----
#
# 方案A · 用宿主机已装的 MySQL（默认，便于用 Navicat 直接看数据）
#   1) 本机装 MySQL 8，建库建账号（在 mysql 客户端里执行）：
#        CREATE DATABASE IF NOT EXISTS ai_classroom
#          CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#        CREATE USER 'ai_classroom'@'%' IDENTIFIED BY '你的密码';
#        GRANT ALL PRIVILEGES ON ai_classroom.* TO 'ai_classroom'@'%';
#        FLUSH PRIVILEGES;
#   2) 把下面 LOCAL_MYSQL_* 填成上面的地址/账号/密码。
#   3) `docker compose up -d`（mysql 容器不会起，profile 已隔离）。
#   注意：Linux 宿主机靠 compose 里的 extra_hosts 把 host.docker.internal
#        指向宿主网关；Windows/macOS 的 Docker Desktop 原生支持该主机名。
#
# 方案B · 用 compose 自带的 mysql 容器（本机没装 MySQL 时最省事）
#   LOCAL_MYSQL_HOST=mysql
#   LOCAL_MYSQL_PORT=3306
#   LOCAL_MYSQL_DATABASE=ai_classroom
#   LOCAL_MYSQL_USER=ai_classroom
#   LOCAL_MYSQL_PASSWORD=与下面 MYSQL_PASSWORD 保持一致
#   启动：docker compose --profile with-mysql up -d
#        （首次 init 可能早于 mysql 就绪而失败，补跑一次：
#          docker compose --profile with-mysql run --rm init）
#
# 方案A 时 MYSQL_* 这组只给「容器 mysql」用，留占位即可。
MYSQL_ROOT_PASSWORD=替换成强密码
MYSQL_DATABASE=ai_classroom
MYSQL_USER=ai_classroom
MYSQL_PASSWORD=替换成强密码

# 后端真正使用的连接参数（宿主机库 / 容器库都写在这里）
LOCAL_MYSQL_HOST=host.docker.internal
LOCAL_MYSQL_PORT=3306
LOCAL_MYSQL_DATABASE=ai_classroom
LOCAL_MYSQL_USER=root
LOCAL_MYSQL_PASSWORD=替换成本机 MySQL 密码

# ---- 跨域（浏览器同源走 /api，这里主要给直连/调试用）----
# 显式白名单：本机前端、nginx(8080)、公网域名等固定来源。
# 局域网内其他电脑的前端来源「无需」写在这里 —— 后端内置了私网正则
# （10.x / 172.16-31.x / 192.168.x.x / 本机回环），会自动放行并允许带凭据。
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","https://your.domain"]

# ---- 上传与课堂 ----
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_SESSIONS=100
SESSION_TTL_SECONDS=3600
CLASSROOM_MAX_FILES=20
CLASSROOM_MAX_BYTES=209715200
CLASSROOM_TOP_K=3
CLASSROOM_MAX_DISTANCE=1.25

# ---- 检索开关（默认值即可，如需回滚 child_title 再改）----
# RAG_RERANK_TEXT=parent_head
# RAG_RERANK_ONLINE=0

# 父子切片检索（小块召回 / 大块注入）。库 chroma_kb 已按父子模式构建
# （chunk_params_hash=1af56b9448eed061），容器里必须同步打开，否则线上退回
# 扁平模式：K=3 / rerank_text=parent_head / floor=-8 这套调优全部失效，
# 实测 nDCG 0.8812 -> 0.7936（-8.76pp）。改这个开关不需要重建库。
RAG_PARENT_CHILD=1
