# Docker 部署环境变量样例 —— 复制为 deploy/.env 后填写
# cp .env.docker.example .env

# ---- LLM ----
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=sk-替换成真实key

# ---- 裁判 / 标注模型（评测专用，不参与线上回答）----
# 只在跑离线评测工具时用到（L3 评判 / 四维评分 / 评测集标注）。
# 三个变量要么全配、要么全不配；留空则回落到上面的 LLM_*。
# 详见 backend/eval/judge_llm.py 与 backend/env.example 的说明。
EVAL_JUDGE_MODEL=qwen3.8-27b
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EVAL_JUDGE_NO_THINK=1

# ---- MySQL（compose 内部网络）----
MYSQL_ROOT_PASSWORD=替换成强密码
MYSQL_DATABASE=ai_classroom
MYSQL_USER=ai_classroom
MYSQL_PASSWORD=替换成强密码

# ---- 跨域（浏览器同源走 /api，这里主要给直连/调试用）----
ALLOWED_ORIGINS=["http://localhost:8080","https://your.domain"]

# ---- 上传与课堂 ----
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_SESSIONS=100
SESSION_TTL_SECONDS=3600
CLASSROOM_MAX_FILES=20
CLASSROOM_MAX_BYTES=209715200
CLASSROOM_TOP_K=3
CLASSROOM_MAX_DISTANCE=1.25

# ---- 检索开关（默认值即可，如需回滚 child_title 再改）----
# RAG_RERANK_TEXT=parent_head
# RAG_RERANK_ONLINE=0

# 父子切片检索（小块召回 / 大块注入）。库 chroma_kb 已按父子模式构建
# （chunk_params_hash=1af56b9448eed061），容器里必须同步打开，否则线上退回
# 扁平模式：K=3 / rerank_text=parent_head / floor=-8 这套调优全部失效，
# 实测 nDCG 0.8812 -> 0.7936（-8.76pp）。改这个开关不需要重建库。
RAG_PARENT_CHILD=1
