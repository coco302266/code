# ===== LLM 配置（生产：DeepSeek，走 OpenAI 兼容通道）=====
# 这是项目实际使用的配置；跑 /chat 必须填 LLM_API_KEY。
# 与 agent/graph.py 的 provider 映射一致：provider=openai -> model=deepseek-flash。
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=your_deepseek_key_here

# ===== 裁判 / 标注模型（评测专用，与生产回答解耦）=====
# 只影响离线评测工具，不参与 /chat 回答。用途：
#   - L3 幻觉率与利用率裁判   eval/grounding_eval.py
#   - 四维质量初评             scripts/judge_scores.py
#   - 评测集出题 + 分档标注     scripts/build_eval_v3.py
# 统一由 backend/eval/judge_llm.py 解析。三个变量**要么全配、要么全不配**：
#   全不配 -> 逐项回落到上面的 LLM_*（改造前的行为）
#   只配一半 -> 直接报错，不静默回落（半套配置会把裁判模型名打到错误的端点上）
#
# 现用阿里云百炼（DashScope，OpenAI 兼容通道）：新用户开通后每模型赠 100 万 token，
# 90 天内有效；免费额度只覆盖华北2（北京）与新加坡地域、只抵扣实时调用，不含 Batch。
EVAL_JUDGE_MODEL=qwen3.8-27b
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# 端点二选一，两者都实测可用（2026-10-30，qwen3.8-27b）：
#   ① 地域端点（本项目现用，推荐）：因为免费额度只覆盖华北2（北京）与新加坡，
#      用工作空间 ID 显式指定地域最稳，不会因为账号默认地域不同而踩坑。
#      https://<你的WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#   ② 公共网关：https://dashscope.aliyuncs.com/compatible-mode/v1
#
# ⚠ 模型 ID 以百炼控制台为准。若调用报「模型不存在」，到
#   https://bailian.console.aliyuncs.com 的模型列表核对 ID（Qwen 版本号更新很快，
#   如 qwen3.8-27b / qwen3.6-27b 这类名字容易写错一位）。
#
# Qwen3 系列默认开启思考，而裁判任务是「按格式出一小段 JSON」。
# 实测对照（qwen3.8-27b，四维评分 prompt，2026-10-30）：
#
#   档位      completion  reasoning  total   延迟     评分结果
#   开思考    454         411        716     13.71s  5/5/4/2
#   关思考    56          0          282     3.63s   5/5/4/2   ← 默认
#
# 即：token 省 2.5 倍、延迟省 3.8 倍，而打分结论完全一致（推理链对这类
# 「套格式」任务没有贡献）。按 100 万 token 免费额度换算，够跑的题量
# 从约 1400 次评分提升到约 3500 次。默认关掉（1=关）。
#
# 各家字段名不同，auto 模式按「端点+模型名」自动选择；识别不出厂商时不发送，
# 宁可多花 token，也不塞一个会让对方 400 的未知参数：
#   Qwen3/DashScope -> enable_thinking:false    DeepSeek -> thinking.type:disabled
EVAL_JUDGE_NO_THINK=1
# EVAL_JUDGE_NO_THINK_STYLE=auto
# EVAL_JUDGE_TEMPERATURE=0

# 本地开发可改用 ollama（需本机起 ollama 服务，无需联网 / key）：
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2

# 其它可选厂商（本项目未启用，保留供参考）：
# LLM_PROVIDER=gemini  /  LLM_MODEL=gemini-2.0-flash     /  GOOGLE_API_KEY=...
# LLM_PROVIDER=groq    /  LLM_MODEL=openai/gpt-oss-120b  /  GROQ_API_KEY=...

# Optional per-provider model overrides
# OLLAMA_MODEL=llama3.2
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash-lite

# Upload/session safety limits
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_SESSIONS=100
SESSION_TTL_SECONDS=3600

# JSON array of allowed browser origins
# 这是浏览器的「来源」，必须和地址栏里那个源逐字一致（协议+主机+端口），
# 不是后端地址。默认只放行本机前端。
ALLOWED_ORIGINS=["http://localhost:3000"]
#
# 双机联调：另一台电脑用浏览器访问你的前端时，要把它地址栏里的源加进来。
#   它打开 http://192.168.1.23:3000  ->  加 "http://192.168.1.23:3000"
#   它跑自己的前端、只连你的后端  ->  通常 localhost:3000 已够（再加兜底也可）
# 多个源用逗号分隔，JSON 语法不能错：
# ALLOWED_ORIGINS=["http://localhost:3000","http://192.168.1.23:3000"]
# 漏配的症状：页面能打开、列表空白、控制台报 CORS，后端日志里请求正常。

# ===== M4 多智能体协作（可选）=====
# 多 Agent 总开关。设为 0 时一切退回单 Agent 行为（单次 LLM 调用），
# 前端与数据库都不用改。演示环境额度吃紧或延迟压不下来时先动这个。
# AGENT_COLLAB=0

# ===== 构建知识库时需要（跑 build_kb.py 前设）=====
# 直连 HuggingFace 会被代理挡，报 502；Windows 上不禁用符号链接会导致
# snapshots 目录为空、加载权重时找不到文件。
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_DISABLE_SYMLINKS=1

# ===== 管理端点鉴权（可选，XB-20）=====
# POST /admin/reload-kb（知识库热重载，会触发一次全库重新加载）的鉴权令牌。
#   不配置：只放行本机（loopback）来源。即使服务被起在 0.0.0.0 上，外网也打不到。
#   配置后：必须带 `X-Admin-Token: <本值>` 头，来源不限（便于远程运维），
#           且本机调用同样要带——行为一致才好排查。
# ⚠ 反向代理后面部署时，服务端看到的来源 IP 是代理地址；若代理跑在本机，
#   会被判成「本机」而放行 —— 那种部署必须配置本令牌。
# ADMIN_RELOAD_TOKEN=

# ===== 课堂资料长期化（XB-23 方案 B）=====
# POST /upload/teacher 加 persist=classroom 时生效：教师资料落盘 + 建课堂级
# 向量库，本课堂学生在 /chat 里能检索到（persist=session 仍是原来的会话级内存库）。
# 原件目录（事实源，换 embedding / 改切片参数时靠它重建）
# CLASSROOM_DOCS_DIR=./classroom_docs
# 派生索引目录（与 chroma_kb 分开，便于备份与清理）
# CLASSROOM_CHROMA_DIR=./chroma_classrooms
# 每课堂配额：文件数 / 总字节上限，超限返回 413
CLASSROOM_MAX_FILES=20
CLASSROOM_MAX_BYTES=209715200
# 每轮 /chat 注入的课堂资料条数上限（三路之一：上传件 / 教材 / 课堂资料）
CLASSROOM_TOP_K=3
# 课堂资料注入的向量距离上限（越小越相关；设 off 关闭）。
# 实测：同类问句 0.72~0.98，离题问句 1.19~1.48，取 1.25 是宁可漏挡不可错杀。
# ⚠ 只有一份教材十个问句的样本，真实课堂语料进来后要重新校准。
CLASSROOM_MAX_DISTANCE=1.25

# ===== 文档路由 L1（XB-26，2026-10-26）=====
# 先选文档、再选切片：把检索范围收窄到 top-N 篇，候选池不再随库变大而稀释。
# 库已过触发条件（>15 篇或 >150 片），默认开。
# 关掉即完全回到「全库竞争」，行为与改动前逐字一致——出问题先关这个。
# RAG_DOC_ROUTER=0
#
# 路由保留几篇文档。实测 route@3 = 71/71，route@1 = 67/71；
# 调小会开始掉金标准文档，调大则收窄收益变小。
# RAG_ROUTER_TOP_DOCS=3
#
# 向量那一路的权重。BM25 主导，向量只做同义改写的兜底。
# 实测 route@3：0 → 69/70，0.3 → 71/71，0.5 → 70/71，1.0（等权）→ 69/71。
# RAG_ROUTER_VEC_WEIGHT=0.3
#
# 路由的向量宽召回条数（只给 RRF 提供名次，几毫秒）。
# RAG_ROUTER_WIDE_K=30
#
# 每篇文档参与聚合的 BM25 最高分切片数。这是**消除文档长度偏置**的关键：
# 全量求和会让 27 片的长文档压过 9 片的文档。
# RAG_ROUTER_BM25_TOPK=3
#
# 域外闸门（查询词 IDF 加权覆盖率下限）。**默认关闭，且不建议现在开**：
# 实测无安全阈值——库外题「Python 列表和元组」覆盖率 0.397，而带 topic 的
# 口语追问只有 0.299，只差 0.098，开闸会静默丢掉追问的资料。
# 要开先用 scripts/calibrate_doc_router.py 复核，别拍脑袋。
# RAG_ROUTER_GATE=off

# ---- 注入多样性（U9）----
# **实测否决：默认必须保持关闭。** 别为了提高「注入来源数」打开。
#
# 83 条评测里 67 条出现「同一文档占 ≥2 个注入位」，看着像浪费，实则本库的问题与文档
# 基本一一对应——「B+ 树索引为什么快」就该给同一篇的三个小节。A/B 实测
# （scripts/ab_source_quota.py，配额前置 + 粗召回扩 2 倍）：
#   同源堆叠 67→37、平均来源 1.458→2.072，但
#   **注入相关率 78.6%→56.2%**（近一半新资料与金标准无关）、p95 +0.53s、9 例少注入，
#   top1 零提升。判据是注入相关率，不是多样性。
#
# 两个开关：配额 = 候选池每篇最多几条（进重排前）；末端限额 = 最终注入每篇最多几条。
# RAG_SOURCE_QUOTA=0
# RAG_MAX_PER_SOURCE=0

# ---- 重排读哪段文本（2026-10-27，默认已开启）----
# child_title = **默认**。命中的那片 + 所属小节标题（几十字）打分，注入仍给整节 parent
# child       = 只用命中的那片（~200 字）打分
# parent      = 用聚合后的整节（600~900 字）打分，等同 2026-10-27 之前的行为
#
# 为什么默认 child_title：重排占检索端到端 97.7%（本机 CPU、无 GPU，成本随序列长度走）。
# 三档 L1 门禁口径对照（75 题/计分 71，各档独立进程，scripts/l1_p95_by_mode.py）：
#   档位         top1    top3   nDCG@4   平均     p95      3.0s 门禁
#   parent       68/71  70/71  0.8818  2.384s  3.655s   ✗ 超 0.655s
#   child        68/71  70/71  0.8549  0.963s  1.103s   ✓
#   child_title  68/71  70/71  0.8651  0.973s  1.134s   ✓  ← 默认
# 相比 parent：耗时 −59%、p95 −69%，top1/top3 完全不变，nDCG 只掉 1.67%。
# 相比 child：多付 1% 耗时换回 38% 的排序损失——标题是整节里信息密度最高的部分，
# 正是纯 child 丢掉的主题信号。
# 只改「喂给交叉编码器什么」，不改召回集合、不改注入文本、不改索引。
#
# ⚠ 回退到 parent 会让 p95 回到约 3.65s，**超过** L1 门禁统一后的 3.0s 预算
# （5s 分档预算正是为 parent 全文打分才设的，child 落地后已统一回 3.0s）。
# RAG_RERANK_TEXT=child_title

# ---- 逐条相关性下限（2026-10-28 O13，由 -5.0 放宽到 -8.0）----
# 整题下限放过之后，再砍掉尾部明显不相关的片。off/none/空 = 关闭。
#
# 为什么放宽：-5.0 是 **inject_k=4 的扁平模式**下标定的，那时准确率分母是 4，
# 砍掉一条垃圾能直接抬高分子占比（实测 +6.2pp）。父子模式 inject_k=3 之后
# 分母恒为 3，砍掉零增益片**不再带来任何准确率收益，只剩误杀成本**。
#
# 实测（ab_recall_pool.py，71 题，父子模式，每档独立进程）：
#   -5.0 → Recall 0.7827 / Precision 0.5587 / nDCG 0.8651 / p95 1.075s
#   -8.0 → Recall 0.7909 / Precision 0.5634 / nDCG 0.8700 / p95 1.081s  ← 默认
#   off  → Recall 0.7909 / Precision 0.5634 / nDCG 0.8653 / p95 1.160s
# 即 -8.0 已拿到「关掉」的全部收益且仍有兜底，几乎不付延迟。
# RAG_PER_DOC_FLOOR=-8.0

# ---- 以下四项**默认全部关闭**，实测为负结论，留着只为不必重跑同样的实验 ----
# 详见 RAG_TUNING_PLAN.md §7.11.3。
#
# ① child 层超额召回倍数（父子模式下 RRF 在 child 层截断、去重在 parent 层，
#    同节多片会塌成一个 parent）。实测：池 4.2→9.2 条，池上限 +6.9pp，
#    但重排挑错同步 +6.7pp，净收益 ≈ 0。
# RAG_CHILD_OVERFETCH=1
#
# ② 进入重排的 parent 候选条数上限（重排按条计费，这是父子模式唯一真成本闸门）。
#    0 = 不限制。实测兜 6 条比不兜更差（RRF 名次不如重排）。
# RAG_PARENT_POOL_K=0
#
# ③ 相邻小节扩展半径：把池里每条 parent 的同文档 ±N 个 `##` 小节补进候选池。
#    理论更划算（每多送一条换来的池上限是盲目扩召回的 1.27 倍），
#    实测 ±1 / ±2 分别 0.7806 / 0.7834，均低于不扩的 0.7909，还贵 0.4~0.6s。
# RAG_ADJACENT_RADIUS=0
#
# ④ 重排名次与 RRF 名次的融合权重（0 = 纯重排）。
#    实测 w=0.5 → 0.7782、w=1.5 → 0.7565，都更差。
# RAG_RERANK_FUSION_W=0


# ---- /chat 评估与检索是否并行（2026-10-27 O3，默认开启）----
# 开(1)：抽 topic → gather(理解评估, 三路检索)。理解评估不读任何检索产物，
#        两者无数据依赖，串起来是白等。
# 关(0)：回到「评估整段跑完再检索」的旧顺序。
#
# 实测（measure_ttft.py，各 8 条，正反序各一轮）：前置段 3126/3122ms（并行）
# vs 4061/4883ms（串行），快 0.94~1.76s。并行侧数值明显更稳——因为它只由
# 评估 LLM 决定，检索被藏在下面。
# ⚠ 收益上限是 min(理解评估, 检索)：较长那侧省不掉。别指望靠它把评估 LLM 的
#   2s 也消掉。
# 留这个开关是为了主链路出问题能一行退回，不靠改代码重发。
# CHAT_PARALLEL_ASSESS=1

# ---- 抽 topic 节点是否关掉推理模型的"思考"（2026-10-27 O11，默认开启）----
# 开(1)：给抽取节点单独发 thinking=disabled。抽 topic 只要回一两个词，
#        而 deepseek-flash 默认会先产出 23~29 个 reasoning token，
#        那一段正是该节点 ~1.0s 的大头。
# 关(0)：抽取节点与其余节点用同一份参数（旧行为）。
#
# 实测（ab_extract_prompt.py，3 轮 × 27 例，正反序）：mean 1012→656ms（−35%）、
# p95 1509→878ms（−42%）；判定准确率 96.3%→97.5%，不降反升（唯一差异那一条
# 还是关掉后判得更准）。
# 只在**抽取**节点关——理解评估要判断学生是否真懂，让它想是值得的。
# 厂商不认该字段时会自动降级重试并记 WARNING，不会让 /chat 挂掉。
# RAG_TOPIC_NO_THINK=1


# ---- /chat 是否「投机执行」抽 topic（2026-10-28 O12，默认开启）----
# 开(1)：不等抽 topic，先用上一轮 topic 并行跑评估与检索。抽 topic 判沿用
#        （追问）就直接采用，判换题则把投机产物作废、用新 topic 重跑。
#        关键路径 E + max(A,R) → max(E,A,R)；命中时省掉 E 全程，未命中时持平。
# 关(0)：退回 O3 的分步并行（先抽 topic，再 gather）。
#
# 为什么不直接「缓存 topic」：XB-31 实测过盲缓存（跳过抽取、沿用上一轮），
# 换题轮上 93% 会退化（注入里混进旧知识点）、13% 期望文档完全丢失；更糟的是
# topic 会落库、下一轮被 load_last_state 读回、还喂给 _update_profile 记
# mastery ⇒ 一次误判跨轮累积，且从回答文本上看不出来。
# 投机执行的延迟收益和盲缓存一样，但 E 仍是唯一裁决者，正确性零损失。
#
# ⚠ 两个前提：① 并行段必须是只读且幂等的（它会被调用两次）
#            ② 未命中时被取消的那次评估调用是否计费，取决于厂商
# CHAT_SPECULATE_TOPIC=1

# 父子切片检索（小块召回 / 大块注入）。库 chroma_kb 已按父子模式构建
# （chunk_params_hash=1af56b9448eed061），这里必须同步打开，否则线上会退回
# 扁平模式：K=3 / rerank_text=parent_head / floor=-8 这套调优全部失效，
# 实测 nDCG 0.8812 -> 0.7936（-8.76pp）。改这个开关不需要重建库。
RAG_PARENT_CHILD=1

# ===== MySQL（可选；不配则后端跑「无数据库」模式）=====
# 判定逻辑在 db/session.py：DATABASE_URL 或 MYSQL_HOST/USER/DATABASE 任一项
# 存在才会建 engine；全不配时 /chat 照常回答，但 agent_runs 零留痕，
# /evaluation/* 全空且不报错——这是最容易误判成「功能坏了」的一种状态。
#
# 二选一：
#   ① 分项（推荐）：填下面 5 行
#   ② 整串：DATABASE_URL=mysql+pymysql://user:pwd@127.0.0.1:3306/ai_classroom?charset=utf8mb4
#
# 本机现状（2026-10-31）：便携版 8.0.29 在 D:/mysql/mysql-8.0.29-winx64，
# 未注册 Windows 服务，需手动起：
#   "D:/mysql/mysql-8.0.29-winx64/bin/mysqld.exe" --defaults-file="D:/mysql/mysql-8.0.29-winx64/my.ini"
# root 当前空密码、只绑 127.0.0.1；对外暴露前必须改密码。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_classroom
