  "_items": [
    {
      "id": "a01",
      "topic": "死锁",
      "hint_level_in": 1,
      "category": "明确表示懂了",
      "history": [
        {
          "role": "student",
          "content": "什么是死锁？"
        },
        {
          "role": "assistant",
          "content": "死锁是多个进程因竞争资源而相互等待，若无外力干预谁都无法推进的永久阻塞状态。注意不是死循环：死循环占着 CPU 一直跑，死锁是全部阻塞、不占 CPU。"
        }
      ],
      "utterance": "明白了，就是互相拿着对方要的资源不放，谁也推不动，谢谢老师！",
      "gold": {
        "resolved": true,
        "misconception": false,
        "hint_up": false
      }
    },
    {
      "id": "a02",
      "topic": "TCP 三次握手",
      "hint_level_in": 1,
      "category": "明确表示懂了",
      "history": [
        {
          "role": "student",
          "content": "TCP 为什么是三次握手，而不是两次？"
        },
        {
          "role": "assistant",
          "content": "两次握手无法阻止历史重复连接初始化，会浪费服务端资源；三次才能双方都确认对方的发送与接收能力正常。"
        }
      ],
      "utterance": "懂了，两次不行是因为服务端没法确认客户端的接收能力，也挡不住历史重复连接。",
      "gold": {
        "resolved": true,
        "misconception": false,
        "hint_up": false
      }
    },
    {
      "id": "a03",
      "topic": "进程与线程",
      "hint_level_in": 2,
      "category": "明确表示懂了",
      "history": [
        {
          "role": "student",
          "content": "进程和线程到底有什么区别？"
        },
        {
          "role": "assistant",
          "content": "进程是资源分配的基本单位，线程是 CPU 调度的基本单位。同一进程的线程共享地址空间和文件描述符，但各有独立的栈和寄存器上下文。"
        }
      ],
      "utterance": "清楚了，线程共享地址空间所以通信快，进程各自独立所以隔离性好、切换成本高。",
      "gold": {
        "resolved": true,
