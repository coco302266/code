  "_items": [
    {
      "id": "a01",
      "topic": "死锁",
      "hint_level_in": 1,
      "category": "明确表示懂了",
      "history": [
        {
          "role": "student",
          "content": "什么是死锁？"
        },
        {
          "role": "assistant",
          "content": "死锁是多个进程因竞争资源而相互等待，若无外力干预谁都无法推进的永久阻塞状态。注意不是死循环：死循环占着 CPU 一直跑，死锁是全部阻塞、不占 CPU。"
        }
      ],
      "utterance": "明白了，就是互相拿着对方要的资源不放，谁也推不动，谢谢老师！",
      "gold": {
        "resolved": true,
        "misconception": false,
        "hint_up": false
      }
    },
    {
      "id": "a02",
      "topic": "TCP 三次握手",
      "hint_level_in": 1,
      "category": "明确表示懂了",
      "history": [
        {
          "role": "student",
          "content": "TCP 为什么是三次握手，而不是两次？"
        },
        {
          "role": "assistant",
          "content": "两次握手无法阻止历史重复连接初始化，会浪费服务端资源；三次才能双方都确认对方的发送与接收能力正常。"
        }
      ],
      "utterance": "懂了，两次不行是因为服务端没法确认客户端的接收能力，也挡不住历史重复连接。",
      "gold": {
        "resolved": true,
        "misconception": false,
        "hint_up": false
      }
    },
    {
