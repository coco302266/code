# 本地运行产物
*.log
.uvicorn.log
.pip.log

# 验收脚本跑完写的输出快照（每次覆盖，不进版本库）
*_out.txt

# T7 生成的 PPT 文件（运行产物，按需重新生成）
generated/

# 本机工作数据（非源码，不进版本库）
.workbuddy/

# 重建库 / 重刷金标准前的本地回滚快照（含 chroma 库 + 基线，体积大，只留本地）
backup_chroma_*/
backup_gold_*/

# IDE
.idea/

# 密钥与本地环境（根目录再兜一层，子项目 .gitignore 已忽略 backend/.env）
.env
.env.*
# 示例文件必须入库，否则新环境无参照（.env.* 会把 .env.docker.example 一起吃掉）
!**/.env.example
!**/*.example

# ===== 重型本地产物（2026-10-30 推送 Gitee 前补）=====
